{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://norm-spec.dev/schema/profiles/root.json",
  "title": "Profile: root",
  "description": "Profile for project documentation root directory (e.g., docs/.norm)",
  "allOf": [
    { "$ref": "../norm-schema.json" }
  ],
  "profile_rules": {
    "required_fields": ["metadata"],
    "recommended_fields": ["template", "agent_rules", "strong_references"],
    "recommended_template": ["required_directories", "single_source_of_truth", "naming_convention"],
    "recommended_agent_rules": ["update_order"]
  }
}
